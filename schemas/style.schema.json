{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deep style profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "axes",
    "philosophy",
    "influences",
    "characteristics",
    "use_cases",
    "typography",
    "color",
    "spacing",
    "composition",
    "imagery",
    "iconography",
    "components",
    "interaction",
    "motion",
    "mobile",
    "accessibility",
    "mistakes",
    "amateurish",
    "exceptional",
    "references",
    "implementation",
    "libraries",
    "evaluation",
    "tokens",
    "sources",
    "version",
    "status",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aesthetic",
        "composition",
        "product",
        "density",
        "motion"
      ],
      "properties": {
        "aesthetic": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "product": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "density": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "motion": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "philosophy": {
      "type": "string",
      "minLength": 1
    },
    "influences": {
      "type": "string",
      "minLength": 1
    },
    "characteristics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "typography": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "minLength": 1
    },
    "spacing": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "string",
      "minLength": 1
    },
    "imagery": {
      "type": "string",
      "minLength": 1
    },
    "iconography": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "string",
      "minLength": 1
    },
    "interaction": {
      "type": "string",
      "minLength": 1
    },
    "motion": {
      "type": "string",
      "minLength": 1
    },
    "mobile": {
      "type": "string",
      "minLength": 1
    },
    "accessibility": {
      "type": "string",
      "minLength": 1
    },
    "mistakes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "amateurish": {
      "type": "string",
      "minLength": 1
    },
    "exceptional": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "libraries": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "muted",
        "accent",
        "on_accent",
        "radius",
        "measure",
        "display"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "on_accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "radius": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "implemented"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  }
}
